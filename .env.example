# Copy this file to .env and fill in the values. .env is ignored by Git.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides (defaults live in defect_automation/config.py)
# GEMINI_MODEL=gemini-3.5-flash-lite
# DB_PATH=var/defects.db
# INPUT_DIR=data/reports

# Mock QM API (defaults shown)
# QM_API_URL=http://127.0.0.1:8001
# QM_API_TOKEN=local-mock-service-account
# MOCK_QM_ERROR_RATE=0.05
# MOCK_QM_RATE_LIMIT_PER_MINUTE=60

# Routing and cost
# CONFIDENCE_THRESHOLD=0.85
# DAILY_COST_CAP_EUR=1.00

# Review screen (required to open the app)
REVIEW_PASSWORD=
# Demo only: accept any password. Leave off for anything but a local demo.
# REVIEW_LOGIN_OPEN=false

# Token for the pipeline API (called by UiPath). Without it the API stays closed.
# Create one: python -c "import secrets; print(secrets.token_urlsafe(24))"
PIPELINE_API_TOKEN=
